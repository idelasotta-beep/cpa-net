// Modelo de datos — Dashboard CPA multi-red (Fase 1).
// Diseño multi-red: una oferta pertenece a una `Network` (Adcombo y futuras).
// Los adapters por red se implementan en Fase 2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Plataforma por la que ENTRA el lead al sistema.
enum Platform {
  estrategias
  pancake
  shopify // pedido creado en una tienda Shopify (form COD de Releasit)
  landing // landing propia self-hosted (form COD propio, sin Shopify)
  manual // creado a mano desde el dashboard
}

// Canal/medio de origen del lead (dentro de la plataforma).
enum Channel {
  shopify
  whatsapp
  webcake
  landing
  manual
}

// Status canónico unificado del lead (cada red traduce su vocabulario a este enum).
enum LeadStatus {
  pending // recién ingerido, aún no enviado a la red
  sent_to_network // enviado a la red CPA, esperando confirmación
  hold // llegó al call center, esperando contacto
  lead // venta confirmada (aprobado) — genera payout
  reject // venta no concretada
  trash // datos basura (no cuenta para approval rate)
  failed // falló el envío a la red tras varios intentos
}

// Quién originó un cambio de status (para auditoría).
enum StatusChangeSource {
  postback
  polling
  manual
  system
}

model Network {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique // ej. "adcombo"
  name        String
  active      Boolean  @default(true)
  pushEnabled Boolean  @default(false) @map("push_enabled") // kill switch del push-pending por red
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  offers Offer[]

  @@map("networks")
}

model Offer {
  id        String  @id @default(uuid()) @db.Uuid
  networkId String  @map("network_id") @db.Uuid
  network   Network @relation(fields: [networkId], references: [id])

  networkOfferId String @map("network_offer_id") // ID de la oferta en la red CPA
  name           String
  country        String // ISO 2 letras
  priceLocal     Decimal @map("price_local") @db.Decimal(12, 2) // precio que paga el cliente (moneda local)
  payoutUsd      Decimal @map("payout_usd") @db.Decimal(10, 2) // comisión al afiliado (siempre USD)

  // Clave de mapeo del producto entrante -> esta oferta.
  // Valor proviene de items[].dropi_product_id del webhook (nombre neutro, sin acoplar a Dropi).
  platformProductId String? @map("platform_product_id")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  leads      Lead[]
  dailyCosts DailyCost[]

  @@unique([networkId, networkOfferId])
  @@index([platformProductId])
  @@map("offers")
}

model Lead {
  id String @id @default(uuid()) @db.Uuid

  externalId String   @map("external_id") // ID del pedido en la plataforma origen
  platform   Platform // por dónde entra el lead (EstrategiasIA, Pancake, manual)
  channel    Channel // canal/medio de origen (shopify, whatsapp, webcake, manual)
  offerId    String?  @map("offer_id") @db.Uuid // nullable hasta resolver el mapeo de producto
  offer      Offer?   @relation(fields: [offerId], references: [id])

  networkLeadId String?    @map("network_lead_id") // ID que devuelve la red al crear el lead
  status        LeadStatus @default(pending)

  customerName    String  @map("customer_name")
  customerPhone   String  @map("customer_phone")
  customerEmail   String? @map("customer_email")
  customerAddress String? @map("customer_address") // dirección legacy/compuesta (EstrategiasIA)
  customerCity    String? @map("customer_city")
  customerRegion  String? @map("customer_region") // texto de la provincia/estado tal cual entra
  customerCountry String  @map("customer_country")

  // Dirección estructurada para fulfillment COD (Latinecom exige estos campos).
  customerStreet         String? @map("customer_street") // calle SIN número
  customerStreetNumber   String? @map("customer_street_number") // número (o "S/N")
  customerPostalCode     String? @map("customer_postal_code")
  customerProvinceId     Int?    @map("customer_province_id") // ID de provincia AR (1-24) para Latinecom
  customerFloor          String? @map("customer_floor")
  customerApartment      String? @map("customer_apartment")
  customerBetweenStreets String? @map("customer_between_streets")
  customerShippingNotes  String? @map("customer_shipping_notes")

  // IP del comprador (capturada en la landing) — para Latinecom y match del CAPI de Meta.
  customerIp String? @map("customer_ip")

  // IDs de click de Meta capturados en la landing propia (mejoran el match del CAPI).
  fbp    String? @map("fbp") // cookie _fbp
  fbc    String? @map("fbc") // cookie _fbc (derivada de fbclid)
  fbclid String? @map("fbclid") // click id crudo de la URL

  // Landing propia de origen (slug = proyecto CF Pages) — atribución para la analítica.
  landingId String? @map("landing_id")

  // Pixel de Meta de la landing (para el CAPI multi-pixel: 1 pixel por país/oferta).
  pixelId String? @map("pixel_id")

  // Combo pedido: cantidad (1/2/3) y total local del combo (Shopify total_price).
  // Se envían a Latinecom como quantity + productPrice (cada combo tiene su precio).
  quantity        Int?     @map("quantity")
  totalPriceLocal Decimal? @map("total_price_local") @db.Decimal(12, 2)

  clickId     String? @map("click_id") // reconciliación / tracking (se envía a la red como subacc/clickId)
  utmSource   String? @map("utm_source")
  utmCampaign String? @map("utm_campaign")
  utmContent  String? @map("utm_content")
  utmTerm     String? @map("utm_term")

  rawPayload    Json    @map("raw_payload") // payload original sin modificar (forensics)
  revenueUsd    Decimal? @map("revenue_usd") @db.Decimal(10, 2) // revenue real que reporta la red al confirmar
  pushAttempts  Int     @default(0) @map("push_attempts")
  lastPushError String? @map("last_push_error")

  createdAt          DateTime  @default(now()) @map("created_at")
  sentToNetworkAt    DateTime? @map("sent_to_network_at")
  lastStatusChangeAt DateTime  @default(now()) @map("last_status_change_at")

  statusHistory LeadStatusHistory[]

  @@unique([externalId, platform]) // idempotencia por plataforma
  @@index([status])
  @@index([platform])
  @@index([channel])
  @@index([createdAt])
  @@index([offerId])
  @@index([customerCity])
  @@index([landingId])
  @@map("leads")
}

/// Analítica de conversión de las landings propias: visitas (beacon) agregadas por
/// landing y día. Los leads se cuentan desde `leads.landing_id`. Sin PII.
model LandingStat {
  id        String   @id @default(uuid()) @db.Uuid
  landingId String   @map("landing_id")
  date      DateTime @db.Date // día (UTC) del agregado
  views     Int      @default(0) // page views totales
  uniques   Int      @default(0) // visitantes únicos (1 por visitante/día, dedup en cliente)
  starts    Int      @default(0) // "form abierto" (InitiateCheckout): inicio del embudo del form

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([landingId, date])
  @@index([landingId])
  @@map("landing_stats")
}

model LeadStatusHistory {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  oldStatus LeadStatus? @map("old_status")
  newStatus LeadStatus  @map("new_status")
  changedAt DateTime @default(now()) @map("changed_at")
  source    StatusChangeSource
  note      String?

  @@index([leadId])
  @@map("lead_status_history")
}

// Config global de la app (fila única, id = "singleton").
model AppSettings {
  id                  String   @id @default("singleton")
  dailyReportEnabled  Boolean  @default(false) @map("daily_report_enabled")
  dailyReportHour     Int      @default(9) @map("daily_report_hour") // 0-23, hora Santiago
  lastDailyReportDate String?  @map("last_daily_report_date") // "YYYY-MM-DD" Santiago (dedup)

  // Email vía Resend, configurable desde Ajustes (sin tocar Railway).
  emailEnabled Boolean @default(false) @map("email_enabled")
  resendApiKey String? @map("resend_api_key")
  emailTo      String? @map("email_to")
  emailFrom    String? @map("email_from") // default onboarding@resend.dev

  // Carritos abandonados: webhook a una URL propia (WhatsApp/n8n/Make) cuando un
  // visitante deja el form empezado (teléfono válido) y no completa tras N minutos.
  abandonedWebhookEnabled Boolean @default(false) @map("abandoned_webhook_enabled")
  abandonedWebhookUrl     String? @map("abandoned_webhook_url")
  abandonedWebhookToken   String? @map("abandoned_webhook_token") // opcional → header Authorization: Bearer
  abandonedDelayMinutes   Int     @default(20) @map("abandoned_delay_minutes") // gracia antes de considerar abandonado

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

/// Carrito abandonado: form empezado (teléfono válido capturado en blur) sin completar.
/// Separado de `leads` para NO pushearlo a la red. Se marca `recovered` si el lead se
/// completa; si no, el job dispara el webhook configurable tras la ventana de gracia.
model AbandonedCart {
  id              String    @id @default(uuid()) @db.Uuid
  submitId        String    @unique @map("submit_id") // idempotencia + link al lead final
  landingId       String?   @map("landing_id")
  sku             String?
  countryCode     String?   @map("country_code")
  customerName    String?   @map("customer_name")
  customerPhone   String?   @map("customer_phone")
  payload         Json // datos parciales completos del form (para el webhook)
  recovered       Boolean   @default(false) // true cuando el lead se completó
  recoveredLeadId String?   @map("recovered_lead_id") @db.Uuid
  webhookSentAt   DateTime? @map("webhook_sent_at")
  webhookAttempts Int       @default(0) @map("webhook_attempts")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([recovered, webhookSentAt, createdAt])
  @@map("abandoned_carts")
}

model DailyCost {
  id        String   @id @default(uuid()) @db.Uuid
  offerId   String   @map("offer_id") @db.Uuid
  offer     Offer    @relation(fields: [offerId], references: [id])
  date      DateTime @db.Date
  amountUsd Decimal  @map("amount_usd") @db.Decimal(10, 2)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([offerId, date])
  @@map("daily_costs")
}
